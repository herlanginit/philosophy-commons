# Copy this file to .env.local (locally) or set it in your hosting provider's
# environment variables (e.g. Vercel Project Settings → Environment Variables).
#
# Published-to-web CSV URL for the Google Sheet that powers the resource
# library. If unset, the site falls back to the seed data in
# src/data/resources.ts. See README.md for how to publish a sheet as CSV.
RESOURCES_SHEET_CSV_URL=
